# Porta local (Railway define PORT sozinho em produção)
PORT=3000

# Primeiro administrador — só é usado se ainda não existir nenhum usuário no banco
ADMIN_EMAIL=voce@simplescontabeis.com
ADMIN_NOME=Seu Nome
ADMIN_PASSWORD=defina-uma-senha-forte-aqui

# Token compartilhado com o agente do Domínio Web (gere uma string aleatória longa e use a MESMA
# nos dois lados: aqui e no .env do agente, que roda numa máquina com acesso ao Domínio Web)
DOMINIO_AGENT_TOKEN=

# Só usado pelo agente/onvio-login-setup, na máquina onde eles rodam (não precisa estar no .env
# do site). Caminho onde fica salva a sessão de login do Onvio criada por `npm run onvio-login`.
# Deixe em branco para usar o padrão (data/onvio-session.json).
DOMINIO_ONVIO_SESSION_PATH=

# E-mail corporativo (SMTP) — usado para o envio automático de arquivos/mensagens aos clientes.
# Preencha com os dados do seu provedor de e-mail corporativo (ex.: Microsoft 365, Google Workspace,
# ou o SMTP do seu provedor de hospedagem de e-mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Simples Contábeis
SMTP_FROM_EMAIL=

# Pasta onde ficam os arquivos anexados pelos clientes e o banco SQLite do site — no Railway isso
# deve apontar para um Volume persistente (senão os arquivos somem a cada deploy).
DATA_DIR=./data
