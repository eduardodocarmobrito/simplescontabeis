    "@types/qrcode": "^1.5.6",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "fast-xml-parser": "^5.11.1",
    "jsbarcode": "^3.12.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "multer": "^2.0.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^1.1.1",
