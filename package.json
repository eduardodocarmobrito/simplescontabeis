  "description": "Portal do escritório Simples Contábeis: solicitações de documentos por cliente, financeiro, relatórios e integração com Domínio Web.",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/nfse-tabelas && cp src/nfse-tabelas/*.json dist/nfse-tabelas/",
    "start": "node dist/server.js",
    "dominio-agent:dev": "tsx src/dominio-agent.ts",
    "dominio-agent": "node dist/dominio-agent.js",
    "onvio-login": "tsx src/onvio-login-setup.ts"
  },
  "keywords": [],
